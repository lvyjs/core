{
  "name": "lvyjs",
  "version": "0.3.0-alpha.5",
  "description": "tsx compile script",
  "author": "lemonade",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsdown",
    "start": "node lib/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "chokidar": "^5.0.0",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "postcss-url": "^10.1.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "types": "lib",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./loader": {
      "import": "./lib/loader.js",
      "types": "./lib/loader.d.ts",
      "require": "./lib/loader.js"
    },
    "./register": {
      "import": "./lib/main.js",
      "types": "./lib/main.d.ts",
      "require": "./lib/main.js"
    },
    "./env": {
      "types": "./env.d.ts"
    },
    "./tsconfig.json": {
      "import": "./tsconfig.json",
      "types": "./tsconfig.json",
      "require": "./tsconfig.json"
    },
    "./tsconfig": {
      "import": "./tsconfig.json",
      "types": "./tsconfig.json",
      "require": "./tsconfig.json"
    }
  },
  "bin": {
    "lvy": "bin/index.js"
  },
  "keywords": [
    "ts",
    "tsx",
    "react",
    "rolldown",
    "esbuild"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/lemonade-lab/lvyjs/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemonade-lab/lvyjs.git"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
